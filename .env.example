# Firebase web configuration (public project identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Server-only service account. Never expose the private key in browser code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Server-only worker endpoint secret; use a random value of at least 32 bytes.
CRON_SECRET=
DAILY_JOB_LIMIT=100
# OpenAI-compatible APIs. Set models offered by your chosen provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# OCR adapter expects an OpenAI-compatible vision chat endpoint.
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
KNOWLEDGE_VERSION=2026-10-10-v1

# Optional Firebase AI Logic adapter for conversation, transcription and OCR
FIREBASE_AI_MODEL=
